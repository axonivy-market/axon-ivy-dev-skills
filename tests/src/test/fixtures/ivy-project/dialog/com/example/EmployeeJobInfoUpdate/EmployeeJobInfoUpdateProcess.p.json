    }, {
      "id" : "f6",
      "type" : "Script",
      "name" : "Prepare job choices",
      "config" : {
        "output" : {
          "code" : [
            "import java.util.ArrayList;",
            "import com.example.JobTitle;",
            "import com.example.Department;",
            "",
            "List<JobTitle> jobTitles = new ArrayList<JobTitle>();",
            "JobTitle currentJobTitle = in.employee.getJobTitle();",
            "if (currentJobTitle == null || currentJobTitle.getTitleCode() == null) {",
            "  currentJobTitle = new JobTitle();",
            "  currentJobTitle.setTitleName(\"Software Engineer\");",
            "  currentJobTitle.setTitleCode(\"ENG\");",
            "  currentJobTitle.setDescription(\"Builds and maintains software applications.\");",
            "}",
            "jobTitles.add(currentJobTitle);",
            "if (!\"SSE\".equals(currentJobTitle.getTitleCode())) {",
            "  JobTitle seniorEngineer = new JobTitle();",
            "  seniorEngineer.setTitleName(\"Senior Software Engineer\");",
            "  seniorEngineer.setTitleCode(\"SSE\");",
            "  seniorEngineer.setDescription(\"Leads implementation work and mentors engineers.\");",
            "  jobTitles.add(seniorEngineer);",
            "}",
            "if (!\"PM\".equals(currentJobTitle.getTitleCode())) {",
            "  JobTitle productManager = new JobTitle();",
            "  productManager.setTitleName(\"Product Manager\");",
            "  productManager.setTitleCode(\"PM\");",
            "  productManager.setDescription(\"Defines product priorities and coordinates delivery.\");",
            "  jobTitles.add(productManager);",
            "}",
            "in.jobTitles = jobTitles;",
            "in.selectedJobTitleCode = currentJobTitle.getTitleCode();",
            "in.jobTitleName = currentJobTitle.getTitleName();",
            "in.jobTitleDescription = currentJobTitle.getDescription();",
            "",
            "List<Department> departments = new ArrayList<Department>();",
            "Department currentDepartment = in.employee.getDepartment();",
            "if (currentDepartment == null || currentDepartment.getDepartmentCode() == null) {",
            "  currentDepartment = new Department();",
            "  currentDepartment.setDepartmentName(\"Engineering\");",
            "  currentDepartment.setDepartmentCode(\"ENG\");",
            "  currentDepartment.setDescription(\"Develops and maintains the company's products.\");",
            "}",
            "departments.add(currentDepartment);",
            "if (!\"PRD\".equals(currentDepartment.getDepartmentCode())) {",
            "  Department product = new Department();",
            "  product.setDepartmentName(\"Product\");",
            "  product.setDepartmentCode(\"PRD\");",
            "  product.setDescription(\"Owns product direction and customer experience.\");",
            "  departments.add(product);",
            "}",
            "if (!\"OPS\".equals(currentDepartment.getDepartmentCode())) {",
            "  Department operations = new Department();",
            "  operations.setDepartmentName(\"Operations\");",
            "  operations.setDepartmentCode(\"OPS\");",
            "  operations.setDescription(\"Supports reliable day-to-day business operations.\");",
            "  departments.add(operations);",
            "}",
            "in.departments = departments;",
            "in.selectedDepartmentCode = currentDepartment.getDepartmentCode();",
            "in.departmentName = currentDepartment.getDepartmentName();",
            "in.departmentDescription = currentDepartment.getDescription();"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 320, "y" : 64 }
      },
