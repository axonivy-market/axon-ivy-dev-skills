          "code" : [
            "import com.example.JobTitle;",
            "",
            "for (int i = 0; i < in.jobTitles.size(); i++) {",
            "  JobTitle title = in.jobTitles.get(i);",
            "  if (in.selectedJobTitleCode.equals(title.getTitleCode())) {",
            "    in.jobTitleName = title.getTitleName();",
            "    in.jobTitleDescription = title.getDescription();",
            "    break;",
            "  }",
            "}"
          ]
        }
