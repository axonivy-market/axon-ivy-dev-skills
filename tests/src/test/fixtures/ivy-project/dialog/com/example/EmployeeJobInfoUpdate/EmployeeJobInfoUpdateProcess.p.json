    }, {
      "id" : "f8",
      "type" : "Script",
      "name" : "Apply selected job information",
      "config" : {
        "output" : {
          "code" : [
            "import com.example.JobTitle;",
            "import com.example.Department;",
            "",
            "for (int i = 0; i < in.jobTitles.size(); i++) {",
            "  JobTitle title = in.jobTitles.get(i);",
            "  if (in.selectedJobTitleCode.equals(title.getTitleCode())) {",
            "    in.employee.setJobTitle(title);",
            "    break;",
            "  }",
            "}",
            "for (int i = 0; i < in.departments.size(); i++) {",
            "  Department department = in.departments.get(i);",
            "  if (in.selectedDepartmentCode.equals(department.getDepartmentCode())) {",
            "    in.employee.setDepartment(department);",
            "    break;",
            "  }",
            "}"
          ]
        }
      },
      "visual" : {
        "at" : { "x" : 320, "y" : 256 }
      },
      "connect" : [
        { "id" : "f19", "to" : "f9" }
      ]
